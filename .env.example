# Copy this file to .env and fill in the values you need.
# Every variable must begin with VITE_ so the browser build can read it.

# Where the contact form sends enquiries. Leave it empty during development and
# the form will validate, show its states, and log the enquiry to the console.
#
# Formspree:  https://formspree.io/f/YOUR_FORM_ID
# Web3Forms:  https://api.web3forms.com/submit
# Custom API: https://api.yourdomain.com/enquiries
VITE_FORM_ENDPOINT=

# Only needed when VITE_FORM_ENDPOINT points at Web3Forms.
VITE_WEB3FORMS_KEY=
