# Copy this file to .env and fill in the value.
# The name must begin with VITE_ so the browser build can read it.

# Formspree form id, the last part of the address Formspree gives you.
# https://formspree.io/f/abcdwxyz  ->  abcdwxyz
#
# Leave it empty during development. The form still validates and still shows
# its loading, success, and error states, and writes the enquiry to the
# browser console instead of sending it.
VITE_FORMSPREE_ID=
