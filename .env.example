# Copy this file to .env and fill in the one you want to use.
# Every name must begin with VITE_ so the browser build can read it.
#
# Set none of them and the form still validates, still shows its loading,
# success, and error states, and writes the enquiry to the browser console
# instead of sending it.

# --- Option 1: Formspree -----------------------------------------------------
# The last part of the address Formspree gives you.
# https://formspree.io/f/abcdwxyz  ->  abcdwxyz
# Note: click the confirmation link in the first email before delivery starts.
VITE_FORMSPREE_ID=

# --- Option 2: Web3Forms -----------------------------------------------------
# The access key emailed to you at https://web3forms.com
# No account is needed, and the free plan has no monthly limit.
VITE_WEB3FORMS_KEY=

# --- Option 3: your own server -----------------------------------------------
# Receives a JSON body: name, email, business, projectType, budget, message.
VITE_FORM_ENDPOINT=

# --- Only needed if you set more than one of the above ------------------------
# One of: formspree, web3forms, custom
VITE_FORM_PROVIDER=
