# Copy this file to .env only if you need to change something.
# Every name must begin with VITE_ so the browser build can read it.
#
# NOTHING HERE IS REQUIRED. The contact form already works, because the
# Web3Forms access key ships with the project in src/lib/enquiry.ts.

# --- Replacing the Web3Forms key ---------------------------------------------
# Set this to point the form at a different Web3Forms key without editing any
# code. It wins over the key in src/lib/enquiry.ts.
#
# Set the same name and value in your host as well, then redeploy, because the
# value is read when the site is built:
#   Vercel   Settings, then Environment Variables
#   Netlify  Site configuration, then Environment variables
VITE_WEB3FORMS_KEY=

# --- Alternatives, only if you ever move away from Web3Forms ------------------
# Setting either of these switches the form over to it.
# VITE_FORMSPREE_ID=
# VITE_FORM_ENDPOINT=
# VITE_FORM_PROVIDER=   # web3forms, formspree, or custom
