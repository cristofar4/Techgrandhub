# Copy this file to .env and fill in your Web3Forms access key.
# The name must begin with VITE_ so the browser build can read it.

# --- The one in use: Web3Forms -----------------------------------------------
# Enter your email address at https://web3forms.com and the access key is
# emailed to you straight away. No account, and no monthly limit.
#
# Set the same name and value in your host as well:
#   Vercel   Settings, then Environment Variables
#   Netlify  Site configuration, then Environment variables
# Then redeploy, because the value is read when the site is built.
VITE_WEB3FORMS_KEY=

# Leave this empty and the form still validates, still shows its loading,
# success, and error states, and writes the enquiry to the browser console
# instead of sending it.

# --- Alternatives, only if you ever move away from Web3Forms ------------------
# VITE_FORMSPREE_ID=
# VITE_FORM_ENDPOINT=
# VITE_FORM_PROVIDER=   # formspree, web3forms, or custom
